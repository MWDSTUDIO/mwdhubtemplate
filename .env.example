# ── Supabase (one project, all weddings) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Used for privileged operations (notifications fan-out,
# vault verification). Never exposed to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Claude (all agents run server-side; the key never leaves the API routes)
ANTHROPIC_API_KEY=sk-ant-...
# Model used by the house agents.
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Google (Calendar + Meet + Drive) ─────────────────────────────────
# OAuth2 refresh-token flow for Estelle's Google account.
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...
# Estelle's calendar (availability + Meet invitations)
GOOGLE_CALENDAR_ID=primary
# Parent Drive folder under which each wedding gets its own folder
GOOGLE_DRIVE_PARENT_FOLDER_ID=...

# ── Email notifications ──────────────────────────────────────────────
RESEND_API_KEY=re_...
NOTIFY_FROM="Madame Wedding Design <house@madamewedding.design>"
# Estelle's inbox — form submissions and vendor replies land here.
HOUSE_INBOX=hello@madamewedding.design

# ── Web push (PWA chat notifications) ────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:hello@madamewedding.design

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
